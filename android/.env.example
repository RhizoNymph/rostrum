# Release signing. Copy to android/.env (gitignored) and fill in; environment
# variables of the same names take precedence. With any of them missing, release
# builds are signed with the debug key and Gradle prints a warning.
#
# The keystore stays outside the repository. PKCS12 keystores (keytool's
# default) use one password for the store and the key, so both are the same.
ROSTRUM_KEYSTORE=/home/nymph/.config/rostrum/android/release.jks
ROSTRUM_KEYSTORE_PASSWORD=change-me
ROSTRUM_KEY_ALIAS=rostrum
ROSTRUM_KEY_PASSWORD=change-me
