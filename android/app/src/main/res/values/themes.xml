<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; everything drawn is Compose (ui/theme/). The window
         background matches RostrumColors.bg so launch shows no white flash. -->
    <style name="Theme.Rostrum" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rostrum_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
